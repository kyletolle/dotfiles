#!/bin/zsh
# claude-sticky [slug | session-uuid] [claude args...]
# Get-or-create: attach to the Claude Code session pinned to (cwd, slug),
# creating it if it does not exist yet. Safe to re-run blindly, which is what
# Zellij session resurrection does with a serialized pane command.
#
# No slug (or a first arg starting with -) means "a new one for today": the slug
# becomes YYYY-MM-DD:N, one past the highest N this cwd already has today, on
# disk, running, or given by /rename. Resurrection never takes this path, because the Zellij hook
# rewrites each pane to `claude-sticky <resolved slug>`.
emulate -L zsh
set -u

slug=
if (( $# )) && [[ $1 != -* ]]; then
  slug=$1
  shift
fi

# Override with CLAUDE_BIN if a machine launches Claude through a wrapper
# (Bruce's claude-start) or installs it somewhere else.
if [[ -n ${CLAUDE_BIN:-} ]]; then
  claude_bin=$CLAUDE_BIN
elif [[ -x $HOME/.local/bin/claude ]]; then
  claude_bin=$HOME/.local/bin/claude
else
  claude_bin=$(command -v claude) || { print -u2 "claude-sticky: no claude on PATH"; exit 1; }
fi

# ~/.env.sh exports ANTHROPIC_API_KEY for scripts; an interactive session should
# use the subscription login, not bill the API account.
unset ANTHROPIC_API_KEY

# A full session UUID as the slug resumes that session (any Claude session, sticky
# or not) from the directory it was started in. It passes no --name, so the session
# keeps the name it has. Resurrection replays the plain `claude --resume <uuid>`,
# which needs no hook rewrite.
if [[ $slug =~ '^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$' ]]; then
  uuid=$slug
  found=$(find "$HOME/.claude/projects" -maxdepth 2 -name "$uuid.jsonl" -print -quit 2>/dev/null)
  [[ -n $found ]] || { print -u2 "claude-sticky: no session file for $uuid"; exit 1; }
  # Prints the session's cwd, then its latest /rename title (the tab name) if any.
  { read -r dir; read -r slug } < <(python3 - "$found" <<'PY'
import json, sys
cwd = title = ""
for line in open(sys.argv[1]):
    d = json.loads(line)
    cwd = cwd or d.get("cwd", "")
    title = d.get("customTitle", title)
print(cwd)
print(title)
PY
)
  [[ -d ${dir:-} ]] && cd -- "$dir"
  [[ -n ${slug:-} ]] || slug=${uuid[1,8]}
  name_args=()
else
  # Prints "<slug> <uuid>". The auto-slug takes max + 1 rather than the first gap,
  # so a number abandoned before its first message is never reused for a later one.
  read -r slug uuid < <(python3 - "$PWD" "$slug" <<'PY'
import datetime, glob, json, os, re, subprocess, sys, uuid
cwd, slug = sys.argv[1], sys.argv[2]
sid = lambda s: str(uuid.uuid5(uuid.NAMESPACE_URL, "claude-sticky:%s:%s" % (cwd, s)))
if not slug:
    day = datetime.date.today().isoformat()
    on_disk = {os.path.basename(f)[:-6] for f in glob.glob(os.path.expanduser("~/.claude/projects/*/*.jsonl"))}
    procs = subprocess.run(["ps", "-eo", "args"], capture_output=True, text=True).stdout
    used = [n for n in range(1, 100)
            if sid("%s:%d" % (day, n)) in on_disk or sid("%s:%d" % (day, n)) in procs]
    # Also count sessions in this cwd that /rename gave today's DAY:N (only the
    # latest title counts). A rename writes to the file, so today's mtime is enough.
    midnight = datetime.datetime.combine(datetime.date.today(), datetime.time()).timestamp()
    for f in glob.glob(os.path.expanduser("~/.claude/projects/*/*.jsonl")):
        if os.path.getmtime(f) < midnight:
            continue
        text = open(f, encoding="utf-8", errors="replace").read()
        where = re.search(r'"cwd":"((?:[^"\\]|\\.)*)"', text)
        titles = re.findall(r'"customTitle":"([^"]*)"', text)
        if where and json.loads('"%s"' % where.group(1)) == cwd and titles:
            m = re.fullmatch(re.escape(day) + r":(\d+)", titles[-1])
            if m:
                used.append(int(m.group(1)))
    slug = "%s:%d" % (day, max(used, default=0) + 1)
print(slug, sid(slug))
PY
)
  [[ -n ${uuid:-} ]] || { print -u2 "claude-sticky: could not resolve a session id"; exit 1; }
  name_args=(--name "$slug")
fi

# Match the flag too: with a UUID slug, this script's own args contain the UUID.
if pgrep -f -- "--(resume|session-id) $uuid" >/dev/null 2>&1; then
  print -u2 "claude-sticky: session '$slug' ($uuid) is already running in another pane."
  exit 1
fi

found=$(find "$HOME/.claude/projects" -maxdepth 2 -name "$uuid.jsonl" -print -quit 2>/dev/null)

# Name this pane's own tab after the slug. Zellij 0.44+ can find the tab by pane id,
# which is safe during resurrection (every pane starts at once). Older Zellij only
# has rename-tab, which hits the focused tab, so there it renames only when this pane
# has focus. (On 0.44 list-clients prints nothing, so that check never passes.)
if [[ -n ${ZELLIJ:-} && -n ${ZELLIJ_PANE_ID:-} ]]; then
  tab_id=$(zellij action list-panes --json 2>/dev/null | python3 -c '
import json, sys
for p in json.load(sys.stdin):
    if not p["is_plugin"] and str(p["id"]) == sys.argv[1]:
        print(p["tab_id"])
        break' "$ZELLIJ_PANE_ID" 2>/dev/null)
  if [[ -n $tab_id ]]; then
    zellij action rename-tab-by-id "$tab_id" "$slug" 2>/dev/null
  elif zellij action list-clients 2>/dev/null |
       awk -v p="terminal_$ZELLIJ_PANE_ID" '$2 == p { f = 1 } END { exit !f }'; then
    zellij action rename-tab "$slug" 2>/dev/null
  fi
fi

if [[ -n $found ]]; then
  exec $claude_bin --resume "$uuid" $name_args "$@"
else
  exec $claude_bin --session-id "$uuid" $name_args "$@"
fi
